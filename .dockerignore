# what Git does not track stays out of the build context and so out of the image (kept equal to .gitignore by container/dockerignore.test.ts); a node_modules built on a Mac must not enter the image
node_modules
**/node_modules
.git
apps/web/dist
**/dist
**/*.log
**/.DS_Store
**/*.tsbuildinfo
**/perf-result.json
**/perf-base.json
# local secrets and the owner's private files never enter an image layer
.env
.env.*
**/.env
**/.env.*
private
# the database and token of a daemon started from this checkout, and the recordings and copies of real data
packages/core/data
packages/adapters/*/fixtures/*.jsonl
packages/adapters/*/fixtures/*.sse
packages/adapters/*/fixtures/*.txt
packages/core/fixtures/*.jsonl
packages/core/src/fixtures/flow/*.json
# generated by `bun run codex:types`
packages/adapters/codex/src/generated
