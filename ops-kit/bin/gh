#!/usr/bin/env bun
// gh-guard
// The check in front of `gh` (docs/design/secret-guard.md). A write whose text holds a value that signs someone
// in stops here, and so does a write from a clone of the public copy that still writes there or to a repository
// the clone marked `ops-kit.noWrite`; everything else goes to the real gh unchanged.
import { existsSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { mergeGranted, repoName, syncedRepositories } from "../src/backlog-client.ts";
import { mergeGateOf, noWriteMarkRefusal, noWriteMarks, noWriteRefusal, noWriteTargets, publicCopyOf } from "../src/config.ts";
import { backlogWrite, bodiesOf, GUARD_MARK, mergeHeadOf, mergeWrite, NO_EQUIVALENT, plainMergeOf, publicSyncMerge, realCommand, writeTargetOf } from "../src/gh-guard.ts";
import { forgeReadOnly, ghReadsOnly } from "../src/gh-reads.ts";
import { findSecrets, hostAws } from "../src/secrets.ts";

const argv = process.argv.slice(2);
const real = realCommand("gh", process.env.PATH ?? "", import.meta.path, GUARD_MARK);
if (real === null) {
  console.error("gh-guard: gh が PATH にありません");
  process.exit(127);
}
// On a machine that must not write to the forge (the app's work machine sets the variable for its Tasks), only what is
// known to read goes on; before anything is read or asked, so nothing of the write leaves this process
if (forgeReadOnly(process.env) && !ghReadsOnly(argv)) {
  console.error("gh-guard: このマシン（作業場）からは GitHub に書き込みません。Issue・コメント・ラベル・Project は ops-kit backlog で書くとアプリの本体が送ります。PR の作成・コメント・マージはアプリの本体の Task で行います");
  process.exit(1);
}
// What can be read only once (the standard input, a pipe, a file descriptor) is kept as bytes and handed on
let stdin: Uint8Array | undefined;
const once = new Map<string, Uint8Array>();
const reads = bodiesOf(argv, (path) => {
  try {
    if (path === "-") return new TextDecoder().decode((stdin ??= new Uint8Array(readFileSync(0))));
    // a pattern gh expands itself (`gh gist create '*.md'`): the files it names, joined. Go's filepath.Glob that gh
    // uses lets `*` match a leading dot, so hidden files are read too
    if (!existsSync(path) && /[*?[]/.test(path)) {
      const files = [...new Bun.Glob(path).scanSync({ onlyFiles: true, absolute: true, dot: true })];
      return files.length === 0 ? null : files.map((f) => readFileSync(f, "utf8")).join("\n");
    }
    if (statSync(path).isFile()) return readFileSync(path, "utf8");
    if (!once.has(path)) once.set(path, new Uint8Array(readFileSync(path)));
    return new TextDecoder().decode(once.get(path)!);
  } catch {
    return null;
  }
}, !process.stdin.isTTY);

// A grant is for one repository: the one this command writes to (named with -R / GH_REPO / the api path, else the clone's own).
// The checks below keep a slip from passing; they are no fence: the Task and the record are told from the environment
// (OPS_KIT_TASK_ID, BACKLOG_URL), which the Task's own shell can change (docs/design/permission-modes.md, "Merge grants")
const grantRepo = async () => writeTargetOf(argv, process.env)?.repo ?? (await repoName(process.env).catch(() => null));
const NO_GRANT_REPO = "書き込み先のリポジトリが読めず、許可文の記録を確かめられません";
const NEW_HEAD = "許可は与えられたときの head のもので、新しいコミットの後は聞き直します";
const texts = (reads ?? []).map((r) => r.text);
// In the app's Task, the backlog of its workspace, and of the other repositories the app syncs, is written
// through the app, whatever form the write takes: written here, the app's next edit starts from the value
// before it and is sent as a conflict. A repository the app does not know goes on. Before the secret check: nothing
// is sent either way. The app is asked only for a backlog write named elsewhere than the workspace
const backlog = process.env.BACKLOG_URL ? backlogWrite(argv, (reads ?? []).map((r) => r.text)) : null;
if (backlog) {
  const workspace = await repoName(process.env).catch(() => null);
  // a write that names no repository goes to the workspace
  let target = backlog.repo ?? workspace;
  let other: string | undefined;
  let stop = target !== null && workspace !== null && target.toLowerCase() === workspace.toLowerCase();
  if (stop) target = workspace;
  if (!stop && target !== null) {
    const synced = await syncedRepositories(process.env);
    if (synced === null) console.error("gh-guard: アプリに届かない（か 5 秒で答えない）ので、同期しているほかのリポジトリは判定していません");
    other = synced?.find((s) => s.repository.toLowerCase() === target.toLowerCase())?.workspaceId;
    stop = other !== undefined;
  }
  if (stop && backlog.instead === NO_EQUIVALENT) {
    // no ops-kit backlog command does it (deleting or moving an Issue): the way to do it is the direct write itself
    console.error(`gh-guard: アプリの Task の中では ${target} のバックログ（Issue・コメント・ラベル・Project）に直接書きません。その操作は ops-kit backlog に無いので、env -u BACKLOG_URL gh … で書いてよい（秘密の検査は残る。直接書いた値はアプリの次の取込みで入る）`);
    process.exit(1);
  }
  if (stop) {
    console.error(`gh-guard: アプリの Task の中では ${target} のバックログ（Issue・コメント・ラベル・Project）に直接書きません。${backlog.instead} を使ってください${other && backlog.instead.startsWith("ops-kit backlog") ? `（${target} は ops-kit backlog … --workspace ${other}）` : ""}（issue-workflow の「操作」）`);
    console.error("ops-kit backlog が壊れている・アプリに届かないときは、その 1 回だけ env -u BACKLOG_URL gh … で書けます（秘密の検査は残る。直接書いた値はアプリの次の取込みで入り、その Issue に送信待ちがあれば競合する）");
    process.exit(1);
  }
}
// In the app's Task of a repository that has a merge gate (`mergeGate` of ops.config.json), a merge from the Task's shell goes only
// as one of a PR the person allowed in the Task's conversation. The gate's own merge is not made from the Task's shell: the Task asks
// the app to run the gate as a job (the gate script's `--merge`), and that job runs in the daemon's environment, which this check is not in.
// Nothing is sent to GitHub either way; the app is asked for every merge from the Task's shell. public-sync's merge of its own
// sync PR on the public copy is not this repository's PR and the gate does not judge it: it goes on with public-sync's mark
const gate = process.env.BACKLOG_URL ? mergeGateOf() : null;
const merge = gate !== null ? mergeWrite(argv, texts) : null;
// the head a granted merge is held to: `gh pr merge` gets `--match-head-commit <head>` added below, so GitHub merges only it
let pin: { at: number; args: string[]; repo: string } | undefined;
if (merge && !publicSyncMerge(argv, process.env, publicCopyOf(), merge.pr)) {
  // a merge outside the gate goes only in a form that hands GitHub the head the grant was given for (`--match-head-commit`,
  // the `sha` of the REST body); `gh stack merge` and graphql have no place for it, so they are not asked about
  const held = mergeHeadOf(argv);
  if (!held.carries) {
    console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（${argv.includes("api") ? "この書き方は前段がどの PR のマージか読めない" : "gh stack merge は head を GitHub に渡せない"}ので、判定の外の許可では通りません）`);
    console.error(`単発の PR は gh pr merge <n> [-R <owner/name>] --rebase --match-head-commit <head> で、スタックの PR は最下段から 1 本ずつ gh api -X PUT repos/<owner>/<name>/pulls/<n>/merge-async -f sha=<head> -f merge_method=rebase でマージします（head は gh pr view <n> [-R <owner/name>] --json headRefOid）。マージの判定は bun ${gate} <PR> --merge（スタックは一番上の PR を --merge-stack で名指しし、下の PR とまとめて判定・マージする）`);
    process.exit(1);
  }
  // and only in the one shape the guard reads as gh reads it; any other shape stops rather than be guessed at
  // the grant is kept by owner/name with no host: a merge sent to another host than github.com is not that grant's
  const otherHost = process.env.GH_HOST && process.env.GH_HOST !== "github.com" ? process.env.GH_HOST : null;
  if (otherHost !== null) {
    console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（GH_HOST が ${otherHost} です。判定の外の許可は github.com の owner/name で記録されるので、ほかのホストのマージには使えません）`);
    process.exit(1);
  }
  const plain = plainMergeOf(argv);
  if (plain === null) {
    console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（判定の外の許可で通るのは決まった形のマージだけです。この書き方は前段が gh と同じに読めると言えないので通りません）`);
    console.error(`決まった形: gh pr merge <n> [-R <owner/name>] --rebase --match-head-commit <head>（--rebase の代わりに --merge か --squash のどれか 1 つ。ほかに付けてよいのは --delete-branch だけ）、または gh api -X PUT repos/<owner>/<name>/pulls/<n>/merge -f sha=<head> [-f merge_method=rebase]（スタックの PR は …/pulls/<n>/merge-async -f sha=<head> -f merge_method=rebase。merge-async は sha が要ります）。head は gh pr view <n> [-R <owner/name>] --json headRefOid`);
    process.exit(1);
  }
  if (held.at === null && plain.head === null) {
    console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（gh api のマージは本文に head の sha（40 桁）が要ります）`);
    console.error("本文に -f sha=<head> を付けます（--input で本文を渡す形は通りません）。head は gh pr view <n> [-R <owner/name>] --json headRefOid。単発は gh pr merge <n> --rebase --match-head-commit <head>、スタックの PR は最下段から gh api -X PUT repos/<owner>/<name>/pulls/<n>/merge-async -f sha=<head> -f merge_method=rebase");
    process.exit(1);
  }
  // the repository gh merges: the one the URL or the api path names (a URL and -R agree in the shape), else -R / GH_REPO / the clone's
  const repo = !process.env.OPS_KIT_TASK_ID ? null : (plain.repo ?? (await grantRepo()));
  // the grant holds for the head the PR had when it was given: the head the command names, else the PR's head now
  let head = plain.head;
  if (repo !== null && head === null) {
    const p = Bun.spawnSync([real, "pr", "view", String(plain.pr), "-R", repo, "--json", "headRefOid", "-q", ".headRefOid"], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
    head = p.exitCode === 0 && /^[0-9a-f]{40}$/.test(p.stdout.toString().trim()) ? p.stdout.toString().trim() : null;
  }
  const granted = repo === null || head === null ? false : await mergeGranted(process.env, repo, "merge", plain.pr, fetch, head);
  if (!granted) {
    const why = !process.env.OPS_KIT_TASK_ID ? "Task の id（OPS_KIT_TASK_ID）が無く、許可文の記録を確かめられません" : repo === null ? NO_GRANT_REPO : head === null ? `${repo} の PR #${plain.pr} の今の head を読めず、許可文の記録を確かめられません` : granted === null ? "アプリに届かず、許可文の記録を確かめられません" : `${repo} の PR #${plain.pr} の head ${head.slice(0, 7)} に利用者の許可文の記録がありません。${NEW_HEAD}`;
    console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（${why}）`);
    console.error(`判定の外でマージするには、利用者が Task の会話で PR #<番号> の判定の外でのマージを認めると通ります（言い方は自由。読めなかったときは「PR #<番号> を判定の外でマージしてよい」の 1 文でも通ります。許可は PR ごと、その head ごと、その Task の会話の中だけ。Task のリポジトリでない PR は、頭に「<owner/name> の 」を付けた決まった文だけが通る）。マージの判定は bun ${gate} <PR> --merge（スタックは一番上の PR を --merge-stack で名指しし、下の PR とまとめて判定・マージする。判定の外でスタックを進めるときは最下段から gh api -X PUT repos/<owner>/<name>/pulls/<n>/merge-async -f sha=<head> -f merge_method=rebase を 1 本ずつ。下の PR が入ると上の PR の head が変わるので、上の PR は新しい head で許可を聞き直す）`);
    process.exit(1);
  }
  // a stack's merge (`…/merge-async`) also merges every unmerged pull request below the one it names, and `sha` pins only the
  // named one: it goes only for the bottom one — its base the default branch, and no unmerged pull request before it in the
  // stack GitHub has registered (read apart from the base, as the gate reads both: the two can disagree) — and stops when
  // either cannot be read
  if (plain.stack) {
    const p = Bun.spawnSync([real, "api", `repos/${repo}/pulls/${plain.pr}`, "--jq", '[.state, .base.ref, .base.repo.default_branch] | join(" ")'], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
    const [state, base, main] = p.exitCode === 0 ? p.stdout.toString().trim().split(" ") : [];
    const s = Bun.spawnSync([real, "api", `repos/${repo}/stacks?pull_request=${plain.pr}`], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
    let below: number[] | null = null;
    try {
      const stacks = s.exitCode === 0 ? (JSON.parse(s.stdout.toString()) as Array<{ pull_requests?: Array<{ number: number; merged_at?: string | null }> }>) : null;
      // no registered stack: nothing is below; one: the unmerged ones before it; more than one, or it is not in it: not judged
      const prs = stacks === null || !Array.isArray(stacks) || stacks.length > 1 ? null : (stacks[0]?.pull_requests ?? []);
      const at = prs === null ? -1 : stacks!.length === 0 ? 0 : prs.findIndex((x) => x.number === plain.pr);
      below = prs === null || at < 0 ? null : prs.slice(0, at).filter((x) => !x.merged_at).map((x) => x.number);
    } catch {
      below = null;
    }
    if (state !== "open" || !base || base !== main || below === null || below.length > 0) {
      const why = !state || !base || !main ? `${repo} の PR #${plain.pr} の base を読めず、スタックの最下段か確かめられません` : state !== "open" ? `${repo} の PR #${plain.pr} は ${state} です` : base !== main ? `${repo} の PR #${plain.pr} の base は ${base} で、既定の枝 ${main} ではありません（merge-async は下のまだマージされていない PR もまとめてマージします）` : below === null ? `${repo} の PR #${plain.pr} の GitHub のスタックを読めず、スタックの最下段か確かめられません` : `GitHub のスタックで ${repo} の PR #${plain.pr} の下にまだマージされていない PR（${below.map((x) => `#${x}`).join("、")}）があります（merge-async はそれもまとめてマージします）`;
      console.error(`gh-guard: アプリの Task の中のマージは ${gate} の --merge / --merge-stack で行います（${why}）`);
      console.error("判定の外の merge-async はスタックの最下段（base が既定の枝で、GitHub のスタックでその下にまだマージされていない PR が無い）の PR だけ通ります。下の PR から 1 本ずつ、それぞれの許可で入れます");
      process.exit(1);
    }
  }
  // `gh pr merge` is told the repository the grant was checked for (gh would otherwise pick its own default, which may be
  // another remote's) and, when it named none, the head that was checked
  if (held.at !== null) pin = { at: held.at, args: ["-R", repo!, ...(plain.head === null ? ["--match-head-commit", head!] : [])], repo: repo! };
}
const host = hostAws();
const hits = (reads ?? []).flatMap((r) => findSecrets(r.text, host));
if (hits.length > 0) {
  console.error(`gh-guard: 投稿を止めました。認証に使える値が本文にあります（${[...new Set(hits.map((h) => `${h.kind}、${h.line} 行目`))].join(" / ")}）`);
  console.error(`値を伏せて（<profile>、<account-id>、XXXX-XXXX）書き直してください。承認が要るなら、${process.env.DEVICE_AUTH_URL ? "device-auth -- <command> で動かします" : "値を出さずに Task の会話で聞いて止めます"}（issue-workflow の「Issue・PR・コメントに書かない値」）`);
  process.exit(1);
}
// A clone of the public copy whose default still writes there. A write named elsewhere goes; one that names
// the public copy, or nothing, stops when GH_REPO or `gh repo view` is the public copy. `gh repo view` answers from the
// remotes, not GH_REPO, so `-R "$(gh repo view …)"` names the public copy although GH_REPO points elsewhere; it is
// asked only for such a write, so a read and a write named elsewhere cost no call. A repository the clone marked
// `ops-kit.noWrite` stops by name, whatever the default is
// a granted merge goes to the repository the front names with -R, whatever the arguments read as
const write = pin ? { repo: pin.repo } : writeTargetOf(argv, process.env);
if (write && (write.repo === null ? noWriteTargets().length > 0 : noWriteRefusal(write.repo) !== null)) {
  const view = () => {
    const p = Bun.spawnSync([real, "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
    return p.exitCode === 0 ? p.stdout.toString().trim() : "";
  };
  // a write that names nothing, where gh cannot say the default, may still land on the mark: a marked clone stops
  const unknown = () => {
    const answer = view();
    const mark = answer === "" && write.repo === null ? noWriteMarks()[0] : undefined;
    return mark ? noWriteMarkRefusal(mark) : noWriteRefusal(answer);
  };
  const refusal = (write.repo ? noWriteMarkRefusal(write.repo) : null) ?? (process.env.GH_REPO ? noWriteRefusal(process.env.GH_REPO) : null) ?? unknown();
  if (refusal) {
    console.error(`gh-guard: 投稿を止めました。${refusal}`);
    process.exit(1);
  }
}
// A pipe or a file descriptor was read to the end: the real gh gets the same bytes from a file
const pass = [...argv];
let scratch: string | undefined;
// after the copies below are placed by index: the added flag moves what stands behind it
const pinned = () => (pin ? [...pass.slice(0, pin.at), ...pin.args, ...pass.slice(pin.at)] : pass);
for (const r of reads ?? []) {
  const bytes = r.from && once.get(r.from.path);
  if (!r.from || !bytes) continue;
  scratch ??= mkdtempSync(join(tmpdir(), "gh-guard."));
  const copy = join(scratch, String(r.from.index));
  writeFileSync(copy, bytes, { mode: 0o600 });
  pass[r.from.index] = `${r.from.prefix}${copy}`;
}
const p = Bun.spawnSync([real, ...pinned()], { stdin: stdin ?? "inherit", stdout: "inherit", stderr: "inherit" });
if (scratch !== undefined) rmSync(scratch, { recursive: true, force: true });
process.exit(p.exitCode ?? 1);
