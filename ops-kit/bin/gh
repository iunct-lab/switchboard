#!/usr/bin/env bun
// gh-guard
// The check in front of `gh` (#661, docs/design/secret-guard.md). A write whose text holds a value that signs someone
// in stops here, and so does a write from a clone of the public copy that still writes there (#2466) or to a repository
// the clone marked `ops-kit.noWrite` (#2576); everything else goes to the real gh unchanged.
import { existsSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { repoName, syncedRepositories } from "../src/backlog-client.ts";
import { noWriteMarkRefusal, noWriteMarks, noWriteRefusal, noWriteTargets } from "../src/config.ts";
import { backlogWrite, bodiesOf, GUARD_MARK, NO_EQUIVALENT, realCommand, writeTargetOf } from "../src/gh-guard.ts";
import { findSecrets, hostAws } from "../src/secrets.ts";

const argv = process.argv.slice(2);
const real = realCommand("gh", process.env.PATH ?? "", import.meta.path, GUARD_MARK);
if (real === null) {
  console.error("gh-guard: gh が PATH にありません");
  process.exit(127);
}
// What can be read only once (the standard input, a pipe, a file descriptor) is kept as bytes and handed on
let stdin: Uint8Array | undefined;
const once = new Map<string, Uint8Array>();
const reads = bodiesOf(argv, (path) => {
  try {
    if (path === "-") return new TextDecoder().decode((stdin ??= new Uint8Array(readFileSync(0))));
    // a pattern gh expands itself (`gh gist create '*.md'`): the files it names, joined. Go's filepath.Glob that gh
    // uses lets `*` match a leading dot, so hidden files are read too
    if (!existsSync(path) && /[*?[]/.test(path)) {
      const files = [...new Bun.Glob(path).scanSync({ onlyFiles: true, absolute: true, dot: true })];
      return files.length === 0 ? null : files.map((f) => readFileSync(f, "utf8")).join("\n");
    }
    if (statSync(path).isFile()) return readFileSync(path, "utf8");
    if (!once.has(path)) once.set(path, new Uint8Array(readFileSync(path)));
    return new TextDecoder().decode(once.get(path)!);
  } catch {
    return null;
  }
}, !process.stdin.isTTY);

// In the app's Task, the backlog of its workspace, and of the other repositories the app syncs (#3073), is written
// through the app (#2694), whatever form the write takes: written here, the app's next edit starts from the value
// before it and is sent as a conflict. A repository the app does not know goes on. Before the secret check: nothing
// is sent either way. The app is asked only for a backlog write named elsewhere than the workspace
const backlog = process.env.BACKLOG_URL ? backlogWrite(argv, (reads ?? []).map((r) => r.text)) : null;
if (backlog) {
  const workspace = await repoName(process.env).catch(() => null);
  // a write that names no repository goes to the workspace
  let target = backlog.repo ?? workspace;
  let other: string | undefined;
  let stop = target !== null && workspace !== null && target.toLowerCase() === workspace.toLowerCase();
  if (stop) target = workspace;
  if (!stop && target !== null) {
    const synced = await syncedRepositories(process.env);
    if (synced === null) console.error("gh-guard: アプリに届かない（か 5 秒で答えない）ので、同期しているほかのリポジトリは判定していません");
    other = synced?.find((s) => s.repository.toLowerCase() === target.toLowerCase())?.workspaceId;
    stop = other !== undefined;
  }
  if (stop && backlog.instead === NO_EQUIVALENT) {
    // no ops-kit backlog command does it (deleting or moving an Issue): the way to do it is the direct write itself
    console.error(`gh-guard: アプリの Task の中では ${target} のバックログ（Issue・コメント・ラベル・Project）に直接書きません。その操作は ops-kit backlog に無いので、env -u BACKLOG_URL gh … で書いてよい（秘密の検査は残る。直接書いた値はアプリの次の取込みで入る）`);
    process.exit(1);
  }
  if (stop) {
    console.error(`gh-guard: アプリの Task の中では ${target} のバックログ（Issue・コメント・ラベル・Project）に直接書きません。${backlog.instead} を使ってください${other && backlog.instead.startsWith("ops-kit backlog") ? `（${target} は ops-kit backlog … --workspace ${other}）` : ""}（issue-workflow の「操作」）`);
    console.error("ops-kit backlog が壊れている・アプリに届かないときは、その 1 回だけ env -u BACKLOG_URL gh … で書けます（秘密の検査は残る。直接書いた値はアプリの次の取込みで入り、その Issue に送信待ちがあれば競合する）");
    process.exit(1);
  }
}
const host = hostAws();
const hits = (reads ?? []).flatMap((r) => findSecrets(r.text, host));
if (hits.length > 0) {
  console.error(`gh-guard: 投稿を止めました。認証に使える値が本文にあります（${[...new Set(hits.map((h) => `${h.kind}、${h.line} 行目`))].join(" / ")}）`);
  console.error("値を伏せて（<profile>、<account-id>、XXXX-XXXX）書き直してください。承認が要るなら、DEVICE_AUTH_URL があれば device-auth -- <command> で動かし、無ければ値を出さずに Task の会話で聞いて止めます（issue-workflow の「Issue・PR・コメントに書かない値」）");
  process.exit(1);
}
// A clone of the public copy whose default still writes there (#2466). A write named elsewhere goes; one that names
// the public copy, or nothing, stops when GH_REPO or `gh repo view` is the public copy. `gh repo view` answers from the
// remotes, not GH_REPO, so `-R "$(gh repo view …)"` names the public copy although GH_REPO points elsewhere; it is
// asked only for such a write, so a read and a write named elsewhere cost no call. A repository the clone marked
// `ops-kit.noWrite` stops by name, whatever the default is (#2576)
const write = writeTargetOf(argv, process.env);
if (write && (write.repo === null ? noWriteTargets().length > 0 : noWriteRefusal(write.repo) !== null)) {
  const view = () => {
    const p = Bun.spawnSync([real, "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"], { stdin: "ignore", stdout: "pipe", stderr: "pipe" });
    return p.exitCode === 0 ? p.stdout.toString().trim() : "";
  };
  // a write that names nothing, where gh cannot say the default, may still land on the mark: a marked clone stops
  const unknown = () => {
    const answer = view();
    const mark = answer === "" && write.repo === null ? noWriteMarks()[0] : undefined;
    return mark ? noWriteMarkRefusal(mark) : noWriteRefusal(answer);
  };
  const refusal = (write.repo ? noWriteMarkRefusal(write.repo) : null) ?? (process.env.GH_REPO ? noWriteRefusal(process.env.GH_REPO) : null) ?? unknown();
  if (refusal) {
    console.error(`gh-guard: 投稿を止めました。${refusal}`);
    process.exit(1);
  }
}
// A pipe or a file descriptor was read to the end: the real gh gets the same bytes from a file
const pass = [...argv];
let scratch: string | undefined;
for (const r of reads ?? []) {
  const bytes = r.from && once.get(r.from.path);
  if (!r.from || !bytes) continue;
  scratch ??= mkdtempSync(join(tmpdir(), "gh-guard."));
  const copy = join(scratch, String(r.from.index));
  writeFileSync(copy, bytes, { mode: 0o600 });
  pass[r.from.index] = `${r.from.prefix}${copy}`;
}
const p = Bun.spawnSync([real, ...pass], { stdin: stdin ?? "inherit", stdout: "inherit", stderr: "inherit" });
if (scratch !== undefined) rmSync(scratch, { recursive: true, force: true });
process.exit(p.exitCode ?? 1);
