{
  "envPrefix": "SWITCHBOARD",
  "forge": { "service": "github" },
  "fields": {
    "area": ["protocol", "core", "adapter-claude", "adapter-codex", "adapter-dak", "web", "knowledge", "ledger", "infra"],
    "kind": ["bug", "feature", "deps", "tech-watch", "eval", "chore"],
    "priority": ["P0", "P1", "P2", "P3"],
    "phase": ["Phase 0", "Phase 1", "Phase 2", "Phase 3"]
  },
  "milestone": {
    "pattern": "^Phase \\d+ — "
  },
  "sections": {
    "pbi": ["ユーザーストーリー", "到達点 / 受け入れ条件", "スコープ外", {"name": "元要望", "hint": "要望 Issue の番号。無ければ「なし（理由）」"}],
    "task": ["親 PBI", "やること", "手順", "検証", "完了条件"],
    "request": [{"name": "要望", "hint": "意図を変えずに整えた文を入れる"}, {"name": "出典", "hint": "誰の言葉 / いつ / 経路"}],
    "origin": {"name": "元要望", "pattern": "^(#[0-9]+([^0-9].*)?|なし[（(].+[）)].*)$", "hint": "`#N（要望のどの部分か）` か `なし（理由）`"}
  },
  "publicSync": {
    "target": "iunct-lab/switchboard",
    "include": [".claude/", ".dockerignore", ".gitattributes", ".github/", ".gitignore", "AGENTS.md", "CLAUDE.md", "LICENSE", "NOTICE", "README.md", "SECURITY.md", "apps/", "aws/", "bun.lock", "bunfig.toml", "container/", "docs/", "ops-kit/", "ops.config.json", "package.json", "packages/", "rescue/", "scripts/", "tsconfig.base.json"],
    "exclude": [
      ".github/workflows/project-autoadd.yml",
      "docs/design/asks.md",
      "docs/design/attachments.md",
      "docs/design/backlog-strict-sync.md",
      "docs/design/backlog-sync.md",
      "docs/design/backlog.md",
      "docs/design/claude-history-import.md",
      "docs/design/codex-stage-check.md",
      "docs/design/dev-history.md",
      "docs/design/evals.md",
      "docs/design/feedback.md",
      "docs/design/github-api-budget.md",
      "docs/design/github-operations.md",
      "docs/design/host-disk.md",
      "docs/design/host-operations.md",
      "docs/design/interventions.md",
      "docs/design/ledger.md",
      "docs/design/license-review.md",
      "docs/design/licenses.md",
      "docs/design/llm-routing.md",
      "docs/design/merge-audit.md",
      "docs/design/merge-gate.md",
      "docs/design/ops-metrics.md",
      "docs/design/presets.md",
      "docs/design/proposal.html",
      "docs/design/pty-bridge.md",
      "docs/design/public-repo.md",
      "docs/design/rate-limit-resume.md",
      "docs/design/repeated-stops.md",
      "docs/design/scheduler.md",
      "docs/design/shadow-run.md",
      "docs/design/spike-bun-compat.md",
      "docs/design/task-cleanup.md",
      "docs/design/task-outcome.md",
      "docs/design/test-audit.md",
      "docs/design/web-csp.md",
      "private/"
    ],
    "rewrite": ["SECURITY.md"],
    "serviceUsers": ["switchboard"],
    "allowRefs": ["private/CLAUDE.md", ".github/workflows/project-autoadd.yml"],
    "versioning": "independent"
  },
  "depsCheck": { "extraConditions": ["typecheck と test を通す。"] }
}
