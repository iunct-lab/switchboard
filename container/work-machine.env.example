# Created by hand when this machine is made a work machine (docs/design/work-machine.md, section 1); never committed
# (it is in .gitignore). Copy this file to container/work-machine.env and fill in the values, then run container/up.sh.
# Fill in every value; a line left empty is set to empty in the container, so delete the ones you do not use.

# "send": this daemon is a work machine of another instance.
SWITCHBOARD_UPLINK=
# Not for use until the checks of section 8 of work-machine.md are done: the value is "not-for-use", and without it
# "send" does not start. Setting it says you run the feature before that, on purpose.
SWITCHBOARD_UPLINK_PREVIEW=
# This machine's name: a letter or digit first, then letters, digits, "_" and "-"; it shows on every Task run here.
SWITCHBOARD_MACHINE=
# The bucket the instance reads the uplink from.
SWITCHBOARD_UPLINK_BUCKET=
# The key of the work machine's IAM user (it writes only under its own machine's prefixes and, with a condition, the
# leases; the daemon and the Tasks of this container can read it), read by the aws CLI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket's region.
AWS_DEFAULT_REGION=
